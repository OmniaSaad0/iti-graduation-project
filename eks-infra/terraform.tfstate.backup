            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"sts:AssumeRoleWithWebIdentity\",\n      \"Principal\": {\n        \"Federated\": \"arn:aws:iam::614563210494:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/DCD9DD41480C47EFEC8CED176B999EE7\"\n      },\n      \"Condition\": {\n        \"StringEquals\": {\n          \"oidc.eks.us-east-1.amazonaws.com/id/DCD9DD41480C47EFEC8CED176B999EE7:sub\": \"system:serviceaccount:default:external-secrets-sa\"\n        }\n      }\n    }\n  ]\n}",
