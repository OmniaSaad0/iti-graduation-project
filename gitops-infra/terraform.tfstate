                "values": "{\"authScripts\":{\"enabled\":true,\"scripts\":{\"auth.sh\":\"#!/bin/sh\\nHOME=/tmp aws ecr --region us-east-1 get-authorization-token --output text --query 'authorizationData[].authorizationToken' | base64 -d\\n\"}},\"config\":{\"registries\":[{\"api_url\":\"https://614563210494.dkr.ecr.us-east-1.amazonaws.com\",\"credentials\":\"ext:/scripts/auth.sh\",\"credsexpire\":\"10h\",\"default\":true,\"insecure\":false,\"name\":\"ECR\",\"ping\":true,\"prefix\":\"614563210494.dkr.ecr.us-east-1.amazonaws.com\"}]},\"serviceAccount\":{\"create\":false,\"name\":\"ecr-read-access-sa\"}}",
